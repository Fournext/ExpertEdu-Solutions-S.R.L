# Root environment variables for ExpertEdu Corporate Website (Docker / EC2)
APP_PORT=8080

# PostgreSQL (isolated corporate database)
POSTGRES_DB=expertedu_corp
POSTGRES_USER=expertedu_corp_user
POSTGRES_PASSWORD=replace_with_strong_password

# Django Corporate API
DJANGO_SECRET_KEY=replace_with_long_random_secret_key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=expertedu.bo,www.expertedu.bo,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://expertedu.bo,https://www.expertedu.bo

# Email Notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@expertedu.bo
COMMERCIAL_INBOX_EMAIL=contacto@expertedu.bo
SUPPORT_INBOX_EMAIL=soporte@expertedu.bo

# Frontend Public Configuration
PUBLIC_API_BASE_URL=/api/v1
PUBLIC_EXPERTEDU_STUDIO_URL=
PUBLIC_SITE_URL=https://expertedu.bo
