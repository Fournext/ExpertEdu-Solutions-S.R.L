# Django Core
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False

# Database (PostgreSQL)
POSTGRES_DB=expertedu_corp
POSTGRES_USER=expertedu_corp_user
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:3000

# Email Notifications (optional: if EMAIL_HOST is empty, emails are logged to console safely)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@expertedu.bo
CONTACT_NOTIFICATION_EMAIL=contacto@expertedu.bo
SUPPORT_NOTIFICATION_EMAIL=soporte@expertedu.bo

# Rate Limiting
CONTACT_THROTTLE_RATE=10/hour
SUPPORT_THROTTLE_RATE=10/hour
