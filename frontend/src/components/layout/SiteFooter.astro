---
import { ExpertEduLogo } from '@/components/brand/ExpertEduLogo';
import { FOOTER_NAVIGATION } from '@/config/navigation';
import { SITE_CONFIG } from '@/config/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-brand-graphite text-slate-300">
  <div class="container-corp py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="inline-block rounded-lg" aria-label="ExpertEdu — Inicio">
          <ExpertEduLogo variant="dark" showTagline />
        </a>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-slate-300">
          {SITE_CONFIG.legalName} desarrolla soluciones tecnológicas educativas interactivas,
          accesibles y orientadas a optimizar los procesos de enseñanza y aprendizaje en
          instituciones de educación superior.
        </p>
        <div class="mt-5 space-y-1.5 text-sm text-slate-300">
          <p>
            <span class="font-medium text-white">Sede:</span>{' '}
            {SITE_CONFIG.location.city}, {SITE_CONFIG.location.country}
          </p>
          <p>
            <span class="font-medium text-white">Comercial:</span>{' '}
            <a
              href={`mailto:${SITE_CONFIG.contact.commercialEmail}`}
              class="underline decoration-slate-500 underline-offset-4 hover:text-white"
            >
              {SITE_CONFIG.contact.commercialEmail}
            </a>
          </p>
          <p>
            <span class="font-medium text-white">Soporte:</span>{' '}
            <a
              href={`mailto:${SITE_CONFIG.contact.supportEmail}`}
              class="underline decoration-slate-500 underline-offset-4 hover:text-white"
            >
              {SITE_CONFIG.contact.supportEmail}
            </a>
          </p>
        </div>
      </div>

      <div class="lg:col-span-2">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
          Empresa
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            FOOTER_NAVIGATION.empresa.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
          Producto y Recursos
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            FOOTER_NAVIGATION.producto.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
          Información Legal
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            FOOTER_NAVIGATION.legal.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-slate-800 pt-6 text-xs text-slate-400 sm:flex-row sm:items-center">
      <p>
        © {currentYear} {SITE_CONFIG.legalName}. Todos los derechos reservados.
      </p>
      <p>Tecnología Educativa (EdTech) — {SITE_CONFIG.location.city}, {SITE_CONFIG.location.country}</p>
    </div>
  </div>
</footer>
