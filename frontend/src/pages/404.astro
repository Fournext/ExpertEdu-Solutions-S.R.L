---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada (404) | ExpertEdu"
  description="La ruta solicitada no se encuentra disponible en el sitio corporativo de ExpertEdu."
  canonicalPath="/404"
  noindex={true}
>
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
      <p class="font-display text-sm font-semibold uppercase tracking-widest text-brand-primary">
        Error 404
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-brand-graphite sm:text-5xl">
        Página no encontrada
      </h1>
      <p class="mt-4 text-base leading-relaxed text-brand-slate">
        La dirección solicitada no existe o fue movida. Puede regresar al inicio o explorar
        nuestras soluciones y canales de contacto.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-lg bg-brand-primary px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-primary-hover"
        >
          Volver al inicio
        </a>
        <a
          href="/producto"
          class="inline-flex items-center justify-center rounded-lg border border-brand-border bg-white px-6 py-3 text-sm font-semibold text-brand-graphite transition hover:border-brand-primary hover:text-brand-primary"
        >
          Conocer ExpertEdu Studio
        </a>
        <a
          href="/contacto"
          class="inline-flex items-center justify-center rounded-lg border border-brand-border bg-white px-6 py-3 text-sm font-semibold text-brand-graphite transition hover:border-brand-primary hover:text-brand-primary"
        >
          Contacto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
