---
import { ExternalLink, Mail, MapPin, ShieldCheck } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ContactForm } from '../components/interactive/ContactForm';
import { SITE_CONFIG } from '../config/site';
---

<BaseLayout
  title="Contacto y solicitud de demostración | ExpertEdu"
  description="Comuníquese con ExpertEdu Solutions S.R.L. para solicitar una demostración de ExpertEdu Studio, cotizar licencias institucionales o consultar sobre soluciones educativas."
  canonicalPath="/contacto"
>
  <section class="border-b border-brand-border bg-brand-surface py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary">
          Contacto comercial e institucional
        </p>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-brand-graphite sm:text-5xl">
          Conversemos sobre las necesidades de su institución
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-brand-slate">
          Solicite una demostración guiada de ExpertEdu Studio, consulte sobre planes académicos o
          plantee un proyecto de tecnología educativa con nuestro equipo.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-brand-border bg-white p-6 shadow-sm sm:p-8">
          <h2 class="font-display text-2xl font-bold text-brand-graphite">
            Formulario de contacto y demostración
          </h2>
          <p class="mt-2 text-sm text-brand-slate">
            Complete los datos y nuestro equipo responderá al correo electrónico indicado.
          </p>
          <div class="mt-6">
            <ContactForm client:load defaultInquiryType="DEMO" sourcePage="/contacto" />
          </div>
        </div>
      </div>

      <aside class="space-y-6 lg:col-span-5">
        <div class="rounded-2xl border border-brand-border bg-brand-surface p-6">
          <h2 class="font-display text-lg font-bold text-brand-graphite">
            Canales oficiales
          </h2>
          <ul class="mt-5 space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <Mail className="mt-0.5 h-5 w-5 shrink-0 text-brand-primary" aria-hidden="true" />
              <div>
                <p class="font-semibold text-brand-graphite">Consultas comerciales y demos</p>
                <p class="mt-0.5 text-brand-slate">
                  <a
                    href={`mailto:${SITE_CONFIG.contact.commercialEmail}`}
                    class="text-brand-primary hover:underline"
                  >
                    {SITE_CONFIG.contact.commercialEmail}
                  </a>
                </p>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <Mail className="mt-0.5 h-5 w-5 shrink-0 text-brand-emerald" aria-hidden="true" />
              <div>
                <p class="font-semibold text-brand-graphite">Soporte técnico</p>
                <p class="mt-0.5 text-brand-slate">
                  <a
                    href={`mailto:${SITE_CONFIG.contact.supportEmail}`}
                    class="text-brand-primary hover:underline"
                  >
                    {SITE_CONFIG.contact.supportEmail}
                  </a>
                </p>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <MapPin className="mt-0.5 h-5 w-5 shrink-0 text-brand-primary" aria-hidden="true" />
              <div>
                <p class="font-semibold text-brand-graphite">Sede de la empresa</p>
                <p class="mt-0.5 text-brand-slate">
                  {SITE_CONFIG.location.streetAddress}
                  <br />
                  {SITE_CONFIG.location.city}, {SITE_CONFIG.location.country}
                </p>
              </div>
            </li>
          </ul>
        </div>

        <div class="overflow-hidden rounded-2xl border border-brand-border bg-white shadow-xs">
          <div class="flex items-center justify-between gap-3 border-b border-brand-border bg-brand-surface px-5 py-3.5">
            <div>
              <h3 class="font-display text-sm font-bold text-brand-graphite">
                Ubicación en el mapa
              </h3>
              <p class="text-xs text-brand-muted">
                {SITE_CONFIG.location.streetAddress}
              </p>
            </div>
            <a
              href={SITE_CONFIG.location.mapLinkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-brand-border bg-white px-3 py-1.5 text-xs font-semibold text-brand-primary transition-colors hover:bg-stone-100"
            >
              Abrir en Maps
              <ExternalLink className="h-3.5 w-3.5" aria-hidden="true" />
            </a>
          </div>
          <div class="h-64 w-full bg-stone-100">
            <iframe
              title={`Mapa de ubicación de ${SITE_CONFIG.legalName} en ${SITE_CONFIG.location.addressNote}`}
              src={SITE_CONFIG.location.mapEmbedUrl}
              class="h-full w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        </div>

        <div class="rounded-2xl border border-brand-border bg-white p-6">
          <div class="flex items-start gap-3">
            <ShieldCheck className="mt-0.5 h-5 w-5 shrink-0 text-brand-emerald" aria-hidden="true" />
            <div>
              <h3 class="font-display text-base font-bold text-brand-graphite">
                Tratamiento responsable de datos
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-brand-slate">
                La información enviada mediante este formulario se utiliza exclusivamente para
                atender su solicitud de demostración o consulta comercial, conforme a nuestra{' '}
                <a href="/privacidad" class="font-semibold text-brand-primary hover:underline">
                  política de privacidad
                </a>
                .
              </p>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
