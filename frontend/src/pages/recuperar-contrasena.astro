---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PasswordResetForm } from '../components/interactive/AuthForms';
---

<BaseLayout
  title="Recuperar contraseña | ExpertEdu"
  description="Restablece la contraseña de tu cuenta corporativa de ExpertEdu mediante un código temporal enviado a tu correo."
  canonicalPath="/recuperar-contrasena"
  noindex={true}
>
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-md px-4 sm:px-6">
      <div class="rounded-2xl border border-brand-border bg-white p-6 shadow-sm sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary">
          Seguridad de cuenta
        </p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-brand-graphite">
          Recuperar contraseña
        </h1>
        <p class="mt-2 text-sm text-brand-slate">
          Ingresa tu correo para recibir un código temporal de 6 dígitos y definir una nueva
          contraseña.
        </p>
        <div class="mt-6">
          <PasswordResetForm client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
