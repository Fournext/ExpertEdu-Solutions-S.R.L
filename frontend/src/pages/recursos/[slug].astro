---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, Calendar, Clock, Tag } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../../config/site';

export async function getStaticPaths() {
  const entries = await getCollection('recursos');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt,
  publisher: {
    '@type': 'Organization',
    name: SITE_CONFIG.legalName,
    url: SITE_CONFIG.domain,
  },
};
---

<BaseLayout
  title={`${entry.data.title} | Recursos ExpertEdu`}
  description={entry.data.description}
  canonicalPath={`/recursos/${entry.id}`}
  ogType="article"
  structuredData={structuredData}
>
  <article class="py-14 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <a
        href="/recursos"
        class="inline-flex items-center gap-2 text-sm font-semibold text-brand-primary transition hover:text-brand-primary-hover"
      >
        <ArrowLeft className="h-4 w-4" aria-hidden="true" />
        Volver a Recursos
      </a>

      <header class="mt-8 border-b border-brand-border pb-8">
        <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-brand-slate">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-primary/10 px-3 py-1 font-semibold text-brand-primary">
            <Tag className="h-3.5 w-3.5" aria-hidden="true" />
            {entry.data.category}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Calendar className="h-3.5 w-3.5" aria-hidden="true" />
            {entry.data.publishedAt}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Clock className="h-3.5 w-3.5" aria-hidden="true" />
            {entry.data.readingTime}
          </span>
        </div>

        <h1 class="mt-5 font-display text-3xl font-bold tracking-tight text-brand-graphite sm:text-4xl">
          {entry.data.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-brand-slate">
          {entry.data.description}
        </p>
      </header>

      <div
        class="mt-10 space-y-6 text-base leading-relaxed text-brand-graphite [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-brand-graphite [&_h3]:mt-6 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-brand-graphite [&_li]:ml-5 [&_li]:list-disc [&_p]:text-brand-slate [&_strong]:font-semibold [&_strong]:text-brand-graphite [&_ul]:space-y-2 [&_ul]:text-brand-slate"
      >
        <Content />
      </div>

      <aside class="mt-14 rounded-2xl border border-brand-border bg-brand-surface p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold text-brand-graphite">
          ¿Desea aplicar estos conceptos en su asignatura?
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-brand-slate">
          Conozca cómo ExpertEdu Studio facilita la enseñanza de Sistemas Expertos con editor
          visual, validación de reglas y trazabilidad del motor Forward Chaining.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="/producto"
            class="inline-flex items-center justify-center rounded-lg bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-primary-hover"
          >
            Explorar ExpertEdu Studio
          </a>
          <a
            href="/contacto"
            class="inline-flex items-center justify-center rounded-lg border border-brand-border bg-white px-5 py-2.5 text-sm font-semibold text-brand-graphite transition hover:border-brand-primary hover:text-brand-primary"
          >
            Solicitar demostración
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
