---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RegisterForm } from '../components/interactive/AuthForms';
---

<BaseLayout
  title="Registro de clientes | ExpertEdu"
  description="Crea tu cuenta en ExpertEdu verificando tu correo electrónico con un código temporal y aceptando nuestras políticas."
  canonicalPath="/registro"
  noindex={true}
>
  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-2xl px-4 sm:px-6">
      <div class="rounded-2xl border border-brand-border bg-white p-6 shadow-sm sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary">
          Alta de clientes
        </p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-brand-graphite">
          Crear cuenta en ExpertEdu
        </h1>
        <p class="mt-2 text-sm text-brand-slate">
          Primero verifica tu correo electrónico con un código temporal para habilitar la creación
          de tu usuario y contraseña.
        </p>
        <div class="mt-6">
          <RegisterForm client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
