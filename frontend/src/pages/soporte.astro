---
import { BookOpen, Headphones, Wrench } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { SupportTicketForm } from '../components/interactive/SupportTicketForm';
import { FaqAccordion, type FaqItem } from '../components/interactive/FaqAccordion';
import { SITE_CONFIG } from '../config/site';

const SUPPORT_LEVELS = [
  {
    level: 'Nivel 1',
    title: 'Autoservicio y documentación',
    description:
      'Guías conceptuales, artículos técnicos y preguntas frecuentes disponibles en el centro de recursos para resolver dudas operativas comunes.',
    icon: BookOpen,
    href: '/recursos',
    cta: 'Explorar recursos',
  },
  {
    level: 'Nivel 2',
    title: 'Mesa de ayuda técnica',
    description:
      'Atención de consultas de acceso, configuración de actividades y orientación de uso mediante tickets registrados o correo electrónico.',
    icon: Headphones,
    href: '#ticket-soporte',
    cta: 'Registrar ticket',
  },
  {
    level: 'Nivel 3',
    title: 'Soporte de ingeniería',
    description:
      'Escalamiento especializado para incidencias técnicas complejas, comportamiento del motor de inferencia o mantenimiento de plataforma.',
    icon: Wrench,
    href: '#ticket-soporte',
    cta: 'Escalar incidencia',
  },
];

const SUPPORT_FAQS: FaqItem[] = [
  {
    question: '¿Cómo consulto el estado de un ticket registrado?',
    answer:
      'Al enviar un ticket recibe un código de referencia (por ejemplo, EXP-XXXXXX). Puede ingresar ese código junto con su correo en la pestaña «Consultar estado» de esta misma página.',
  },
  {
    question: '¿Qué información debo incluir para agilizar la revisión?',
    answer:
      'Indique el producto o módulo involucrado, el comportamiento esperado frente al observado y, si aplica, la categoría e impacto de la incidencia.',
  },
  {
    question: '¿Puedo escribir directamente por correo electrónico?',
    answer:
      `Sí. También puede comunicarse con nuestro equipo técnico escribiendo a ${SITE_CONFIG.contact.supportEmail}.`,
  },
];
---

<BaseLayout
  title="Soporte técnico | ExpertEdu"
  description="Canales de soporte técnico de ExpertEdu Solutions S.R.L., niveles de atención, registro de tickets y consulta de estado."
  canonicalPath="/soporte"
>
  <section class="border-b border-brand-border bg-brand-surface py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary">
          Centro de soporte
        </p>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-brand-graphite sm:text-5xl">
          Acompañamiento técnico estructurado
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-brand-slate">
          Organizamos la atención técnica en tres niveles para orientar a docentes, estudiantes y
          equipos institucionales de forma clara y trazable.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Niveles de atención"
        title="Estructura de soporte ExpertEdu"
        subtitle="Cada caso se canaliza según su complejidad técnica para ofrecer una respuesta ordenada."
      />

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          SUPPORT_LEVELS.map((item) => {
            const Icon = item.icon;
            return (
              <div class="flex flex-col justify-between rounded-2xl border border-brand-border bg-white p-6 shadow-sm">
                <div>
                  <div class="flex items-center justify-between">
                    <span class="rounded-full bg-brand-primary/10 px-3 py-1 text-xs font-semibold text-brand-primary">
                      {item.level}
                    </span>
                    <Icon className="h-5 w-5 text-brand-primary" aria-hidden="true" />
                  </div>
                  <h3 class="mt-4 font-display text-xl font-bold text-brand-graphite">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-brand-slate">{item.description}</p>
                </div>
                <div class="mt-6">
                  <a
                    href={item.href}
                    class="text-sm font-semibold text-brand-primary hover:underline"
                  >
                    {item.cta} &rarr;
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section id="ticket-soporte" class="border-t border-brand-border bg-brand-surface py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Mesa de ayuda"
        title="Registrar o consultar un ticket de soporte"
        subtitle={`También puede escribir directamente a ${SITE_CONFIG.contact.supportEmail}.`}
        align="center"
      />
      <div class="mt-10 rounded-2xl border border-brand-border bg-white p-6 shadow-sm sm:p-8">
        <SupportTicketForm client:load />
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Preguntas frecuentes"
        title="Información sobre soporte"
        align="center"
      />
      <div class="mt-10">
        <FaqAccordion client:load items={SUPPORT_FAQS} />
      </div>
    </div>
  </section>
</BaseLayout>
