---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SuperAdminDashboard } from '../components/interactive/SuperAdminDashboard';
---

<BaseLayout
  title="Panel Superadmin | ExpertEdu"
  description="Panel ejecutivo de ExpertEdu Solutions S.R.L. con KPIs de usuarios por producto/plan y bandeja de correos corporativos."
  canonicalPath="/superadmin"
  noindex={true}
>
  <section class="border-b border-brand-border bg-brand-surface py-12 sm:py-16">
    <div class="container-corp">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary">
        Administración central corporativa
      </p>
      <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-brand-graphite sm:text-4xl">
        Panel Superadmin: KPIs y Correos
      </h1>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container-corp">
      <SuperAdminDashboard client:load />
    </div>
  </section>
</BaseLayout>
