---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { ContactForm } from '@/components/interactive/ContactForm';
import { Building2, CheckCircle2, ClipboardCheck, GraduationCap, Laptop, Puzzle } from 'lucide-react';

const institutionalBenefits = [
  {
    title: 'Innovación educativa sin hardware adicional',
    description:
      'Plataforma 100% web accesible desde laboratorios existentes o equipos personales de docentes y estudiantes.',
    icon: Laptop,
  },
  {
    title: 'Herramientas estructuradas para docentes',
    description:
      'Facilita la preparación de casos de estudio, explicación visual en aula y revisión ordenada de entregas.',
    icon: GraduationCap,
  },
  {
    title: 'Experiencias prácticas para estudiantes',
    description:
      'Transforma conceptos teóricos de Inteligencia Artificial simbólica en ejercicios interactivos con retroalimentación clara.',
    icon: Building2,
  },
  {
    title: 'Gestión y seguimiento académico',
    description:
      'Espacios de trabajo aislados por estudiante, historial de entregas y trazabilidad para evaluación continua.',
    icon: ClipboardCheck,
  },
];
---

<BaseLayout
  title="Para Universidades e Instituciones — ExpertEdu"
  description="Soluciones EdTech B2B para universidades, facultades y direcciones de carrera. Moderniza tus laboratorios de enseñanza con ExpertEdu."
>
  <section class="border-b border-brand-border bg-brand-surface py-16 sm:py-20">
    <div class="container-corp">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary">
        Soluciones institucionales B2B
      </p>
      <h1 class="mt-2 max-w-3xl font-display text-4xl font-bold tracking-tight text-brand-graphite sm:text-5xl">
        Tecnología educativa para universidades, facultades y carreras
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-brand-slate sm:text-lg">
        Acompañamos a directores de carrera, decanos y coordinadores académicos en la
        modernización de laboratorios prácticos mediante herramientas web seguras, mantenibles y
        adaptadas al entorno universitario.
      </p>
    </div>
  </section>

  <!-- Beneficios institucionales -->
  <section class="py-16 sm:py-20">
    <div class="container-corp">
      <SectionHeading
        eyebrow="Valor institucional"
        title="Beneficios para la gestión académica"
      />

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          institutionalBenefits.map((item) => {
            const Icon = item.icon;
            return (
              <div class="rounded-2xl border border-brand-border bg-white p-6">
                <Icon className="h-6 w-6 text-brand-primary" aria-hidden="true" />
                <h3 class="mt-4 font-display text-xl font-bold text-brand-graphite">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-brand-slate">{item.description}</p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Escenarios de uso e integraciones futuras -->
  <section class="border-y border-brand-border bg-brand-surface py-16 sm:py-20">
    <div class="container-corp grid gap-8 lg:grid-cols-12">
      <div class="rounded-2xl border border-brand-border bg-white p-6 sm:p-8 lg:col-span-7">
        <h2 class="font-display text-2xl font-bold text-brand-graphite">
          Escenarios de utilización institucional
        </h2>
        <ul class="mt-5 space-y-3 text-sm text-brand-slate">
          <li class="flex items-start gap-2.5">
            <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-brand-accent-dark" aria-hidden="true" />
            <span>
              <strong>Laboratorios de Inteligencia Artificial y Sistemas Expertos:</strong> prácticas
              guiadas de modelado de reglas, validación y análisis de inferencia.
            </span>
          </li>
          <li class="flex items-start gap-2.5">
            <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-brand-accent-dark" aria-hidden="true" />
            <span>
              <strong>Evaluaciones prácticas con aislamiento de trabajos:</strong> cada estudiante
              resuelve su actividad sobre una copia propia sin alterar la plantilla docente.
            </span>
          </li>
          <li class="flex items-start gap-2.5">
            <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-brand-accent-dark" aria-hidden="true" />
            <span>
              <strong>Adopción por carrera o facultad:</strong> habilitación coordinada para
              múltiples cátedras y cohortes bajo licencia institucional.
            </span>
          </li>
        </ul>
      </div>

      <div class="rounded-2xl border border-dashed border-brand-primary/40 bg-white p-6 sm:p-8 lg:col-span-5">
        <div class="flex items-center justify-between gap-2">
          <Puzzle className="h-6 w-6 text-brand-primary" aria-hidden="true" />
          <span class="rounded-md bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-900">
            Integraciones futuras
          </span>
        </div>
        <h2 class="mt-4 font-display text-xl font-bold text-brand-graphite">
          Interoperabilidad con entornos LMS
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-brand-slate">
          La hoja de ruta institucional contempla evaluar integraciones con plataformas educativas
          como Moodle o Canvas según los requerimientos técnicos de cada universidad. Estas
          integraciones se encuentran planificadas como mejoras futuras y se evalúan caso por caso.
        </p>
      </div>
    </div>
  </section>

  <!-- Formulario institucional -->
  <section id="contacto-institucional" class="py-16 sm:py-20">
    <div class="container-corp grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Solicitud institucional"
          title="Solicita una demostración para tu facultad o carrera"
          subtitle="Completa el formulario para coordinar una presentación técnica con autoridades académicas o docentes."
        />
        <div class="mt-6 rounded-xl border border-brand-border bg-brand-surface p-5 text-sm text-brand-slate">
          <p class="font-semibold text-brand-graphite">¿Qué incluye la demostración?</p>
          <ul class="mt-2.5 space-y-1.5 text-xs">
            <li>• Recorrido funcional por ExpertEdu Studio.</li>
            <li>• Revisión de necesidades de tus asignaturas y docentes.</li>
            <li>• Orientación sobre esquemas de licenciamiento referenciales.</li>
          </ul>
        </div>
      </div>

      <div class="rounded-2xl border border-brand-border bg-white p-6 shadow-xs sm:p-8 lg:col-span-7">
        <ContactForm
          client:load
          defaultInquiryType="INSTITUTIONAL_LICENSING"
          sourcePage="/universidades"
        />
      </div>
    </div>
  </section>
</BaseLayout>
